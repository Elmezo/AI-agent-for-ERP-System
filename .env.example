# ---------------------------------------------------------------------------
# Dynamic ERP Agent - environment configuration
# Copy this file to ".env" and adjust values. Never commit real secrets.
# ---------------------------------------------------------------------------

# ---- ERP API access -------------------------------------------------------
# Which adapter the agent uses to reach the ERP backend: "mock" or "real".
# "mock"  -> talks to the bundled FastAPI mock server (mock_erp/server.py)
# "real"  -> talks to your real ERP; only base_url + credentials change.
ERP_ADAPTER=mock

# Base URL of the ERP backend (mock server default shown below).
ERP_BASE_URL=http://127.0.0.1:8000

# Credentials used by the Auth Manager (login/refresh/logout).
# Leave blank to disable authentication (mock server allows anonymous reads).
ERP_USERNAME=demo
ERP_PASSWORD=demo

# Login endpoint relative path (used by the Auth Manager).
ERP_AUTH_LOGIN_PATH=/auth/login
ERP_AUTH_LOGOUT_PATH=/auth/logout

# HTTP behaviour
ERP_TIMEOUT_SECONDS=15
ERP_MAX_RETRIES=3

# ---- LLM (Ollama) ---------------------------------------------------------
# Default model. llama3.1 (8B) gives the best accuracy among locally installed
# models for planning + bilingual answers. Lighter/faster: llama2:7b.
# Best for Arabic wording specifically: command-r7b-arabic:latest.
OLLAMA_MODEL=llama3.1:latest
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Temperature for planning/answering (low = more deterministic).
OLLAMA_TEMPERATURE=0.1
# Request timeout for the LLM in seconds (high to survive cold model loads).
OLLAMA_TIMEOUT_SECONDS=300
# GPU layers to offload. Leave unset to let Ollama auto-detect.
# Set to 0 to force CPU-only inference. Required on old/unstable GPUs (e.g.
# NVIDIA Maxwell, compute capability 5.0) where the CUDA backend crashes the
# llama runner during model load ("exit code 2" / access violation 0xc0000005).
# OLLAMA_NUM_GPU=0

# ---- Web search (Tavily) --------------------------------------------------
# Optional ChatGPT-style web-search fallback for general-knowledge / real-time
# questions the assistant cannot answer from its own knowledge or the ERP.
# Get a key at https://app.tavily.com. Leave blank to disable web search.
TAVILY_API_KEY=
# Number of search results to retrieve per query.
WEB_SEARCH_MAX_RESULTS=5
# Search depth: "basic" (faster, cheaper) or "advanced" (better quality).
WEB_SEARCH_DEPTH=advanced
# Per-request timeout (seconds) and retry budget for transient failures.
WEB_SEARCH_TIMEOUT_SECONDS=20
WEB_SEARCH_MAX_RETRIES=2

# ---- Storage / memory -----------------------------------------------------
# SQLite file used for LangGraph checkpoints and long-term memory.
SQLITE_PATH=./data/agent.db

# ---- Caching --------------------------------------------------------------
# Time-to-live (seconds) for cached entity lookups / searches.
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=2048

# ---- Relationship resolution ----------------------------------------------
# Maximum hop depth when resolving foreign keys into readable names.
MAX_REL_DEPTH=3

# ---- Paths to config files -------------------------------------------------
API_REGISTRY_PATH=./config/api_registry.json
FACETS_PATH=./config/facets.yaml
SEMANTIC_CATALOG_PATH=./schema/semantic_catalog.yaml

# ---- Logging --------------------------------------------------------------
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# Pretty console logs ("console") or machine-readable ("json").
LOG_FORMAT=console
